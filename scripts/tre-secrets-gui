#!/usr/bin/env bash
set -Eeuo pipefail

command -v zenity >/dev/null || { echo "Zenity non installato" >&2; exit 1; }

ask(){
  local title="$1" text="$2" hidden="${3:-false}" result
  if [[ "$hidden" == true ]]; then
    result="$(zenity --password --title="$title" --text="$text" 2>/dev/null || true)"
  else
    result="$(zenity --entry --title="$title" --text="$text" 2>/dev/null || true)"
  fi
  printf '%s' "$result"
}

save(){
  local key="$1" value="$2"
  [[ -z "$value" ]] || sudo /usr/local/bin/tre-vault set "$key" "$value" >/dev/null
}

zenity --info --title="TRE — Configurazione iniziale" --width=520 \
  --text="I dati saranno salvati esclusivamente sul computer U50 in un vault cifrato. Non saranno inviati al repository GitHub. Puoi lasciare vuoti i campi che compilerai più avanti."

TAILSCALE_KEY="$(ask 'TRE — Tailscale' 'Incolla una Tailscale auth key riutilizzabile o monouso:' true)"
GEMINI_KEY="$(ask 'TRE — Gemini' 'Incolla la API key Gemini:' true)"
TELEGRAM_TOKEN="$(ask 'TRE — Telegram' 'Incolla il token del bot Telegram:' true)"
TELEGRAM_CHAT="$(ask 'TRE — Telegram' 'Inserisci il Telegram chat ID autorizzato:')"
GITHUB_TOKEN="$(ask 'TRE — GitHub' 'Incolla un GitHub token dedicato a TRE:' true)"
COINBASE_NAME="$(ask 'TRE — Coinbase' 'Nome della Coinbase API key (facoltativo):')"
COINBASE_SECRET="$(ask 'TRE — Coinbase' 'Secret della Coinbase API key (facoltativo):' true)"
GOOGLE_EMAIL="$(ask 'TRE — Google' 'Account Google dedicato a TRE:')"
GOOGLE_PASSWORD="$(ask 'TRE — Google' 'Password account Google dedicato (facoltativa):' true)"

save tailscale.auth_key "$TAILSCALE_KEY"
save ai.gemini.api_key "$GEMINI_KEY"
save telegram.bot_token "$TELEGRAM_TOKEN"
save telegram.authorized_chat_id "$TELEGRAM_CHAT"
save github.token "$GITHUB_TOKEN"
save coinbase.api_key_name "$COINBASE_NAME"
save coinbase.api_secret "$COINBASE_SECRET"
save google.account_email "$GOOGLE_EMAIL"
save google.account_password "$GOOGLE_PASSWORD"

while zenity --question --title="TRE — VPS" --text="Vuoi registrare una VPS?" --ok-label="Aggiungi VPS" --cancel-label="Continua" 2>/dev/null; do
  VPS_NAME="$(ask 'TRE — VPS' 'Nome breve VPS, es. nemotron o coinbase:')"
  [[ -z "$VPS_NAME" ]] && continue
  VPS_NAME="$(printf '%s' "$VPS_NAME" | tr '[:upper:] ' '[:lower:]_' | tr -cd 'a-z0-9_-')"
  VPS_IP="$(ask 'TRE — VPS' 'IP pubblico o indirizzo Tailscale:')"
  VPS_USER="$(ask 'TRE — VPS' 'Utente SSH:')"
  VPS_PORT="$(ask 'TRE — VPS' 'Porta SSH:' )"; VPS_PORT="${VPS_PORT:-22}"
  VPS_PASSWORD="$(ask 'TRE — VPS' 'Password SSH, solo se necessaria:' true)"

  save "vps.$VPS_NAME.ip" "$VPS_IP"
  save "vps.$VPS_NAME.user" "$VPS_USER"
  save "vps.$VPS_NAME.port" "$VPS_PORT"
  save "vps.$VPS_NAME.password" "$VPS_PASSWORD"

  if zenity --question --title="TRE — Chiave SSH" --text="Vuoi importare una chiave privata SSH per $VPS_NAME?" 2>/dev/null; then
    KEY_PATH="$(zenity --file-selection --title="Seleziona la chiave SSH privata" 2>/dev/null || true)"
    [[ -z "$KEY_PATH" ]] || sudo /usr/local/bin/tre-vault set-file "vps.$VPS_NAME.ssh_private_key" "$KEY_PATH" >/dev/null
  fi
done

if [[ -n "$TAILSCALE_KEY" ]]; then
  zenity --info --title="TRE — Tailscale" --text="Ora TRE collegherà U50 alla rete Tailscale." --timeout=4 2>/dev/null || true
  sudo tailscale up --auth-key="$TAILSCALE_KEY" --hostname="u50-tre" --ssh --accept-dns=true --accept-routes=false
  sudo /usr/local/bin/tre-vault delete tailscale.auth_key >/dev/null || true
fi

TS_IP="$(tailscale ip -4 2>/dev/null | head -n1 || true)"
zenity --info --title="TRE — Configurazione completata" --width=520 \
  --text="Vault configurato.\n\nIP Tailscale U50: ${TS_IP:-non ancora disponibile}\nDesktop remoto: porta 3389, accessibile soltanto tramite Tailscale.\n\nPer aggiungere in futuro una credenziale:\nsudo tre-vault set nome.chiave\n\nTRE/OpenClaw dovrà usare lo stesso comando quando gli chiedi di memorizzare una credenziale."
